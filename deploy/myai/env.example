# Host-only file. Do not commit a filled copy.
# Build the image off MyAI and push it to Nexus:
#   docker build --build-arg HERMES_WORKSPACE_BASE=/hermes \
#     -t repo.awg.ru:2221/awg-hermes-workspace:<sha> .
# On MyAI only docker pull that image. Do not run pnpm build there.

HERMES_WORKSPACE_IMAGE=repo.awg.ru:2221/awg-hermes-workspace:<sha>
HERMES_API_URL=
HERMES_DASHBOARD_URL=
HERMES_API_TOKEN=
HERMES_PASSWORD=

# Read-only coordinates for the eIPP snapshot guard. Names only, no DSN.
EIPP_PG_CONTAINER=
EIPP_PG_USER=
EIPP_PG_DATABASE=
